+        activateManaAbility(3, PhaseStep.DECLARE_ATTACKERS, playerA, "{T}: Add {U}", 1);
+        castSpell(3, PhaseStep.DECLARE_ATTACKERS, playerA, "Double Major", "Ambush Viper", "Ambush Viper");
